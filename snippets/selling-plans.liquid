{%- if product.selling_plan_groups.size > 0 -%}
  {{ 'component-selling-plans.css' | asset_url | stylesheet_tag }}

  <product-subscriptions class="ii-selling-plans" data-module="product/subscriptions">
    <input type="hidden" name="selling_plan" value="" data-selling-plan-input>

    <fieldset class="ii-selling-plans__fieldset">
      <legend class="ii-selling-plans__legend">Purchase options</legend>

      <div class="ii-selling-plan">
        <input
          class="ii-selling-plan__radio"
          type="radio"
          name="purchase_option"
          id="selling-plan-onetime-{{ product.id }}"
          value=""
          checked
        >
        <label for="selling-plan-onetime-{{ product.id }}">
          {{- 'products.product.selling_plans.one_time_purchase' | t -}}
        </label>
      </div>

      {%- assign product_variant = product.selected_or_first_available_variant -%}
      {%- for group in product.selling_plan_groups -%}
        {%- assign first_plan = group.selling_plans.first -%}
        {%- if first_plan.id -%}
          {%- liquid
            assign first_allocation = false
            for selling_plan_allocation in product_variant.selling_plan_allocations
              if selling_plan_allocation.selling_plan.id == first_plan.id
                assign first_allocation = selling_plan_allocation
                break
              endif
            endfor
            assign first_adjustment = first_plan.price_adjustments.first
          -%}

          <div class="ii-selling-plan">
            <input
              class="ii-selling-plan__radio"
              type="radio"
              name="purchase_option"
              id="selling-plan-group-{{ group.id }}"
              value="{{ first_plan.id }}"
              data-selling-plan-radio
              {% if group.selling_plans.size > 1 %}aria-controls="selling-plan-options-{{ group.id }}"{% endif %}
            >
            <label for="selling-plan-group-{{ group.id }}">
              <strong>{{ group.name }}</strong>
              {% if first_allocation %}<span>{{ first_allocation.price | money }}</span>{% endif %}
              {% if first_adjustment.value_type == 'percentage' and first_adjustment.value > 0 %}
                <small>Save {{ first_adjustment.value }}%</small>
              {% endif %}
            </label>

            {% if group.selling_plans.size > 1 %}
              <div class="ii-selling-plan__options" id="selling-plan-options-{{ group.id }}">
                <label for="selling-plan-select-{{ group.id }}">Delivery frequency</label>
                <select
                  id="selling-plan-select-{{ group.id }}"
                  name="purchase_option_values"
                  data-selling-plan-select
                  data-selling-plan-group="{{ group.id }}"
                  disabled
                >
                  {%- for plan in group.selling_plans -%}
                    <option value="{{ plan.id }}">{{ plan.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {% endif %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </fieldset>
  </product-subscriptions>
{%- endif -%}
