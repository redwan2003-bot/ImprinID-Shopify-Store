  <h3 class="imprintid-pricing__heading">{{ 'dynamic_pricing.heading' | t }}</h3>

  <p class="imprintid-pricing__unavailable" data-imprintid-pricing-unavailable hidden>
    {{ 'dynamic_pricing.unsupported_product' | t }}
  </p>

  <p class="imprintid-pricing__loading" data-imprintid-pricing-loading hidden aria-live="polite">
    {{ 'dynamic_pricing.loading_options' | t }}
  </p>

  <div class="imprintid-pricing__panel" data-imprintid-pricing-panel hidden>
    <form data-imprintid-pricing-form novalidate>
      <div class="imprintid-pricing__main-controls">
        <div class="imprintid-pricing__grid-row">
          <div class="imprintid-pricing__field imprintid-pricing__field--qty">
            <input
              type="number"
              id="imprintid-pricing-quantity-{{ block.id }}"
              name="quantity"
              class="imprintid-pricing__control imprintid-pricing__input"
              data-imprintid-pricing-quantity
              min="1"
              step="1"
              inputmode="numeric"
              placeholder="{{ 'dynamic_pricing.qty_placeholder' | t | default: 'Qty*' }}"
              aria-label="{{ 'dynamic_pricing.quantity_label' | t }}"
              aria-describedby="imprintid-pricing-quantity-error-{{ block.id }}"
            >
            <p id="imprintid-pricing-quantity-error-{{ block.id }}" class="imprintid-pricing__field-error" data-imprintid-pricing-quantity-error hidden role="alert"></p>
          </div>

          <div class="imprintid-pricing__field imprintid-pricing__field--color" data-imprintid-pricing-color-wrap hidden>
            <div class="imprintid-pricing__select-wrapper">
              <select
                id="imprintid-pricing-color-{{ block.id }}"
                class="imprintid-pricing__control imprintid-pricing__select"
                data-imprintid-pricing-color
                aria-label="{{ 'dynamic_pricing.color_label' | t }}"
              ></select>
              <span class="imprintid-pricing__select-arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </div>
          </div>
        </div>

        <div class="imprintid-pricing__options" data-imprintid-pricing-options>
          {%- comment -%} Dropdown menus (Attachments, Optional Features, etc.) inserted here by JS {%- endcomment -%}
        </div>
      </div>

      <fieldset class="imprintid-pricing__field imprintid-pricing__decoration-fieldset" data-imprintid-pricing-decoration-fieldset hidden>
        <legend>{{ 'dynamic_pricing.decoration_legend' | t }}</legend>

        <div class="imprintid-pricing__field">
          <label for="imprintid-pricing-colors-{{ block.id }}">{{ 'dynamic_pricing.colors_label' | t }}</label>
          <select id="imprintid-pricing-colors-{{ block.id }}" data-imprintid-pricing-colors>
            <option value="1">{{ 'dynamic_pricing.colors_one' | t }}</option>
            <option value="2">{{ 'dynamic_pricing.colors_two' | t }}</option>
          </select>
        </div>

        <div class="imprintid-pricing__field">
          <label for="imprintid-pricing-locations-{{ block.id }}">{{ 'dynamic_pricing.locations_label' | t }}</label>
          <select id="imprintid-pricing-locations-{{ block.id }}" data-imprintid-pricing-locations>
            <option value="1">{{ 'dynamic_pricing.locations_one' | t }}</option>
            <option value="2">{{ 'dynamic_pricing.locations_two' | t }}</option>
          </select>
        </div>

        <div class="imprintid-pricing__field imprintid-pricing__field--checkbox">
          <input type="checkbox" id="imprintid-pricing-reverse-{{ block.id }}" data-imprintid-pricing-reverse-side>
          <label for="imprintid-pricing-reverse-{{ block.id }}">{{ 'dynamic_pricing.reverse_side_label' | t }}</label>
        </div>

        <div class="imprintid-pricing__field imprintid-pricing__field--checkbox" data-imprintid-pricing-reverse-artwork-wrap hidden>
          <input type="checkbox" id="imprintid-pricing-reverse-artwork-{{ block.id }}" data-imprintid-pricing-reverse-artwork>
          <label for="imprintid-pricing-reverse-artwork-{{ block.id }}">{{ 'dynamic_pricing.different_reverse_artwork_label' | t }}</label>
        </div>

        <div class="imprintid-pricing__field imprintid-pricing__field--checkbox">
          <input type="checkbox" id="imprintid-pricing-repeat-{{ block.id }}" data-imprintid-pricing-repeat-order>
          <label for="imprintid-pricing-repeat-{{ block.id }}">{{ 'dynamic_pricing.repeat_order_label' | t }}</label>
        </div>
      </fieldset>

      <div class="imprintid-pricing__field imprintid-pricing__field--production" data-imprintid-pricing-production-wrap hidden>
        <label for="imprintid-pricing-production-{{ block.id }}">{{ 'dynamic_pricing.production_label' | t }}</label>
        <div class="imprintid-pricing__select-wrapper">
          <select id="imprintid-pricing-production-{{ block.id }}" class="imprintid-pricing__control imprintid-pricing__select" data-imprintid-pricing-production></select>
          <span class="imprintid-pricing__select-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
        <p class="imprintid-pricing__hint" data-imprintid-pricing-production-hint></p>
      </div>
    </form>

    <div class="imprintid-pricing__result" data-imprintid-pricing-result aria-live="polite">
      <div class="imprintid-pricing__unit-prices">
        <div>
          <span class="imprintid-pricing__unit-label">{{ 'dynamic_pricing.list_price_label' | t }}</span>
          <span data-imprintid-pricing-list-unit>—</span>
        </div>
        <div>
          <span class="imprintid-pricing__unit-label">{{ 'dynamic_pricing.your_price_label' | t }}</span>
          <span data-imprintid-pricing-net-unit>—</span>
        </div>
      </div>

      <div class="imprintid-pricing__total">
        <span class="imprintid-pricing__total-label">{{ 'dynamic_pricing.total_label' | t }}</span>
        <span data-imprintid-pricing-total>—</span>
      </div>

      <p class="imprintid-pricing__tier-note" data-imprintid-pricing-tier-note></p>

      <table class="imprintid-pricing__tier-table" data-imprintid-pricing-tier-table hidden>
        <caption>{{ 'dynamic_pricing.quantity_breaks_caption' | t }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ 'dynamic_pricing.quantity_breaks_qty_header' | t }}</th>
            <th scope="col">{{ 'dynamic_pricing.list_price_label' | t }}</th>
            <th scope="col">{{ 'dynamic_pricing.your_price_label' | t }}</th>
          </tr>
        </thead>
        <tbody data-imprintid-pricing-tier-table-body></tbody>
      </table>

      <details class="imprintid-pricing__breakdown" data-imprintid-pricing-breakdown>
        <summary>{{ 'dynamic_pricing.breakdown_summary' | t }}</summary>
        <dl data-imprintid-pricing-breakdown-list></dl>
      </details>
    </div>

    <p class="imprintid-pricing__error" data-imprintid-pricing-error hidden role="alert"></p>

    <div class="imprintid-pricing__actions">
      <div class="imprintid-pricing__button-row">
        <button
          type="button"
          class="imprintid-pricing__btn imprintid-pricing__btn--primary imprintid-pricing__add-to-cart"
          data-imprintid-pricing-add-to-cart
          disabled
        >
          {{ 'dynamic_pricing.add_to_cart' | t }}
        </button>
        <button
          type="button"
          class="imprintid-pricing__btn imprintid-pricing__btn--secondary"
          data-imprintid-pricing-request-info
        >
          {{ 'dynamic_pricing.request_info' | t | default: 'Request Info' }}
        </button>
        <button
          type="button"
          class="imprintid-pricing__btn imprintid-pricing__btn--secondary"
          data-imprintid-pricing-request-quote
        >
          {{ 'dynamic_pricing.request_quote' | t | default: 'Request Quote' }}
        </button>
      </div>
      <p class="imprintid-pricing__add-to-cart-status" data-imprintid-pricing-add-to-cart-status aria-live="polite"></p>
    </div>

    <dialog class="imprintid-pricing__modal" data-imprintid-pricing-info-modal>
      <div class="imprintid-pricing__modal-dialog">
        <div class="imprintid-pricing__modal-header">
          <h4>Request Information</h4>
          <button type="button" class="imprintid-pricing__modal-close" data-imprintid-pricing-modal-close aria-label="Close">&times;</button>
        </div>
        <form class="imprintid-pricing__modal-body" data-imprintid-pricing-info-form>
          <div class="imprintid-pricing__modal-field">
            <label for="info-name-{{ block.id }}">Name *</label>
            <input type="text" id="info-name-{{ block.id }}" class="imprintid-pricing__input" required placeholder="Your full name">
          </div>
          <div class="imprintid-pricing__modal-field">
            <label for="info-email-{{ block.id }}">Email *</label>
            <input type="email" id="info-email-{{ block.id }}" class="imprintid-pricing__input" required placeholder="your.email@example.com">
          </div>
          <div class="imprintid-pricing__modal-field">
            <label for="info-message-{{ block.id }}">Message *</label>
            <textarea id="info-message-{{ block.id }}" class="imprintid-pricing__textarea" rows="3" required placeholder="What would you like to know about this product?"></textarea>
          </div>
          <div class="imprintid-pricing__modal-footer">
            <button type="submit" class="imprintid-pricing__btn imprintid-pricing__btn--primary">Send Message</button>
            <button type="button" class="imprintid-pricing__btn imprintid-pricing__btn--cancel" data-imprintid-pricing-modal-close>Cancel</button>
          </div>
          <p class="imprintid-pricing__modal-success" data-imprintid-pricing-info-success hidden>Thank you! Your inquiry has been sent.</p>
        </form>
      </div>
    </dialog>

    <dialog class="imprintid-pricing__modal" data-imprintid-pricing-quote-modal>
      <div class="imprintid-pricing__modal-dialog">
        <div class="imprintid-pricing__modal-header">
          <h4>Request a Custom Quote</h4>
          <button type="button" class="imprintid-pricing__modal-close" data-imprintid-pricing-modal-close aria-label="Close">&times;</button>
        </div>
        <form class="imprintid-pricing__modal-body" data-imprintid-pricing-quote-form>
          <div class="imprintid-pricing__modal-field">
            <label for="quote-name-{{ block.id }}">Name *</label>
            <input type="text" id="quote-name-{{ block.id }}" class="imprintid-pricing__input" required placeholder="Your full name">
          </div>
          <div class="imprintid-pricing__modal-field">
            <label for="quote-email-{{ block.id }}">Email *</label>
            <input type="email" id="quote-email-{{ block.id }}" class="imprintid-pricing__input" required placeholder="your.email@example.com">
          </div>
          <div class="imprintid-pricing__modal-field">
            <label for="quote-qty-{{ block.id }}">Quantity</label>
            <input type="number" id="quote-qty-{{ block.id }}" class="imprintid-pricing__input" min="1" placeholder="100">
          </div>
          <div class="imprintid-pricing__modal-field">
            <label for="quote-notes-{{ block.id }}">Project Requirements &amp; Notes</label>
            <textarea id="quote-notes-{{ block.id }}" class="imprintid-pricing__textarea" rows="3" placeholder="Colors, in-hand dates, attachments, or custom branding specifications..."></textarea>
          </div>
          <div class="imprintid-pricing__modal-footer">
            <button type="submit" class="imprintid-pricing__btn imprintid-pricing__btn--primary">Submit Quote Request</button>
            <button type="button" class="imprintid-pricing__btn imprintid-pricing__btn--cancel" data-imprintid-pricing-modal-close>Cancel</button>
          </div>
          <p class="imprintid-pricing__modal-success" data-imprintid-pricing-quote-success hidden>Quote request submitted! We will be in touch shortly.</p>
        </form>
      </div>
    </dialog>
  </div>
</div>

