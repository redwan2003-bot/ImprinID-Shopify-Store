{% liquid
  assign category_menu = section.settings.category_menu
  assign utility_menu = section.settings.utility_menu
  assign utility_catalog_menu = section.settings.utility_catalog_menu
  assign meeting_url = section.settings.meeting_url | default: routes.root_url
%}

{{ 'section-imprintid-header.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if settings.predictive_search_enabled -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.cart_type == 'drawer' -%}
  {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart.css' | asset_url | stylesheet_tag }}
  {{ 'component-totals.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'imprintid-header.js' | asset_url }}" defer="defer"></script>

<header class="ii-header" data-ii-header data-section-id="{{ section.id }}">
  <div class="ii-announcement">
    <div class="ii-shell ii-announcement__inner">
      <div class="ii-announcement__message">
        <span>{{ section.settings.announcement_text }}</span>
        {% if section.settings.announcement_link_label != blank %}
          <a href="{{ section.settings.announcement_link | default: routes.root_url }}">
            {{- section.settings.announcement_link_label -}}
          </a>
        {% endif %}
      </div>

      <div class="ii-announcement__tools">
        <details class="ii-utility-menu" data-ii-details-menu>
          <summary aria-controls="ii-utility-panel-{{ section.id }}">
            {{ section.settings.utility_label }}
            <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
          </summary>
          <div class="ii-utility-menu__panel" id="ii-utility-panel-{{ section.id }}">
            {% if utility_menu.links.size > 0 %}
              {% for link in utility_menu.links %}
                {% if link.links.size > 0 %}
                  <details class="ii-utility-menu__nested">
                    <summary>{{ link.title }}</summary>
                    <div>
                      <a href="{{ link.url }}">View all</a>
                      {% for childlink in link.links %}
                        <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                      {% endfor %}
                    </div>
                  </details>
                {% else %}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {% endif %}
              {% endfor %}
            {% else %}
              <a href="/pages/create-flyer">Create Flyer</a>
              <a href="/pages/sales-flyer">Sales Flyer</a>
              <a href="/pages/order-catalog">Order Catalog</a>
              <a href="/pages/submit-a-po">Submit a PO</a>
              <details class="ii-utility-menu__nested">
                <summary>View Catalog</summary>
                <div>
                  <a href="/pages/view-catalog">Digital Catalog</a>
                  {% for link in utility_catalog_menu.links %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endfor %}
                </div>
              </details>
              <a href="/pages/stock-designs">Stock Designs</a>
              <a href="/pages/events-industries">Events &amp; Industries</a>
            {% endif %}
          </div>
        </details>

        <span class="ii-announcement__divider" aria-hidden="true"></span>

        <a class="ii-header-icon" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0"/></svg>
        </a>

        <a class="ii-header-icon ii-cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
          {% if cart == empty %}{% render 'icon-cart-empty' %}{% else %}{% render 'icon-cart' %}{% endif %}
          {% if cart != empty %}
            <div class="cart-count-bubble">
              {% if cart.item_count < 100 %}<span aria-hidden="true">{{ cart.item_count }}</span>{% endif %}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  <div class="ii-mainbar">
    <div class="ii-shell ii-mainbar__inner">
      <button
        class="ii-mobile-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="ii-mobile-nav-{{ section.id }}"
        data-ii-mobile-toggle
      >
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'sections.header.menu' | t }}</span>
      </button>

      <a class="ii-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 420 | image_tag: widths: '180, 240, 320, 420', width: section.settings.logo_width, loading: 'eager', alt: shop.name }}
        {% else %}
          <span class="ii-logo__imprint">imprint</span><span class="ii-logo__id">ID</span>
        {% endif %}
      </a>

      <div class="ii-categories ii-menu" data-ii-menu>
        <button
          class="ii-categories__trigger ii-menu__trigger"
          id="ii-categories-trigger-{{ section.id }}"
          type="button"
          aria-expanded="false"
          aria-controls="ii-categories-panel-{{ section.id }}"
          data-ii-menu-trigger
        >
          {{ section.settings.categories_label }}
          <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
        </button>

        <div
          class="ii-mega ii-menu__panel"
          id="ii-categories-panel-{{ section.id }}"
          aria-labelledby="ii-categories-trigger-{{ section.id }}"
          data-ii-menu-panel
          hidden
        >
          <nav class="ii-mega__tabs" aria-label="Product categories">
            {% for link in category_menu.links %}
              <a
                class="ii-mega__tab{% if forloop.first %} is-active{% endif %}"
                id="ii-category-link-{{ section.id }}-{{ forloop.index0 }}"
                href="{{ link.url }}"
                data-ii-tab="{{ forloop.index0 }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                {{ link.title }}
              </a>
            {% endfor %}
          </nav>

          <div class="ii-mega__content">
            {% for link in category_menu.links %}
              <div
                class="ii-mega__panel{% if forloop.first %} is-active{% endif %}"
                data-ii-tab-panel="{{ forloop.index0 }}"
                aria-labelledby="ii-category-link-{{ section.id }}-{{ forloop.index0 }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {% if link.links.size > 0 %}
                  {% for childlink in link.links %}
                    <div class="ii-mega__group">
                      <a class="ii-mega__heading" href="{{ childlink.url }}">{{ childlink.title }}</a>
                      {% for grandchildlink in childlink.links %}
                        <a href="{{ grandchildlink.url }}">{{ grandchildlink.title }}</a>
                      {% endfor %}
                      {% if childlink.links.size > 0 %}
                        <a class="ii-mega__view" href="{{ childlink.url }}">View All</a>
                      {% endif %}
                    </div>
                  {% endfor %}
                {% else %}
                  <div class="ii-mega__empty">
                    <strong>{{ link.title }}</strong>
                    <a href="{{ link.url }}">Shop this category</a>
                  </div>
                {% endif %}
              </div>
            {% else %}
              <div class="ii-mega__empty">
                <strong>Categories</strong>
                <a href="{{ routes.all_products_collection_url }}">Shop all products</a>
              </div>
            {% endfor %}
          </div>

          <aside class="ii-mega__promo">
            <a href="{{ section.settings.mega_promo_link | default: routes.all_products_collection_url }}">
              {% if section.settings.mega_promo_image != blank %}
                {{ section.settings.mega_promo_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', loading: 'lazy', alt: section.settings.mega_promo_title }}
              {% else %}
                <span class="ii-mega__promo-placeholder">{{ section.settings.mega_promo_title }}</span>
              {% endif %}
              <span>{{ section.settings.mega_promo_title }}</span>
            </a>
          </aside>
        </div>
      </div>

      <nav class="ii-brandnav" aria-label="Brand navigation">
        {% for block in section.blocks %}
          {% if block.type == 'brand_link' %}
            {% liquid
              assign navigation_style = block.settings.navigation_style
              assign label_key = block.settings.label | downcase
              if navigation_style == 'auto' or navigation_style == blank
                if label_key contains 'ecutive' or label_key contains 'treme'
                  assign navigation_style = 'mega'
                elsif label_key contains 'usa made'
                  assign navigation_style = 'link'
                else
                  assign navigation_style = 'dropdown'
                endif
              endif
            %}

            {% if navigation_style == 'link' %}
              <a class="ii-brandnav__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                {% if block.settings.logo != blank %}
                  {{ block.settings.logo | image_url: width: 220 | image_tag: widths: '110, 160, 220', loading: 'lazy', alt: block.settings.label }}
                {% else %}
                  <span class="ii-brandnav__wordmark">{{ block.settings.label }}</span>
                {% endif %}
              </a>
            {% else %}
              <div class="ii-brandnav__item ii-menu" data-ii-menu {{ block.shopify_attributes }}>
                <button
                  class="ii-brandnav__trigger ii-menu__trigger"
                  id="ii-brand-trigger-{{ section.id }}-{{ block.id }}"
                  type="button"
                  aria-expanded="false"
                  aria-controls="ii-brand-panel-{{ section.id }}-{{ block.id }}"
                  data-ii-menu-trigger
                >
                  {% if block.settings.logo != blank %}
                    {{ block.settings.logo | image_url: width: 220 | image_tag: widths: '110, 160, 220', loading: 'lazy', alt: block.settings.label }}
                  {% else %}
                    <span class="ii-brandnav__wordmark">{{ block.settings.label }}</span>
                  {% endif %}
                  <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
                </button>

                <div
                  class="ii-brand-panel ii-brand-panel--{{ navigation_style }} ii-menu__panel"
                  id="ii-brand-panel-{{ section.id }}-{{ block.id }}"
                  aria-labelledby="ii-brand-trigger-{{ section.id }}-{{ block.id }}"
                  data-ii-menu-panel
                  hidden
                >
                  <div class="ii-brand-panel__links">
                    {% if block.settings.menu.links.size > 0 %}
                      {% for link in block.settings.menu.links %}
                        <div class="ii-brand-panel__group">
                          <a class="ii-brand-panel__heading" href="{{ link.url }}">{{ link.title }}</a>
                          {% for childlink in link.links %}<a href="{{ childlink.url }}">{{ childlink.title }}</a>{% endfor %}
                        </div>
                      {% endfor %}
                    {% elsif label_key contains 'ecutive' %}
                      <a href="{{ routes.search_url }}?q=RTIC">RTIC®</a>
                      <a href="{{ routes.search_url }}?q=Igloo">Igloo®</a>
                      <a href="{{ routes.search_url }}?q=Manhattan+Ridge">Manhattan Ridge®</a>
                      <a href="{{ routes.search_url }}?q=Titus">Titus®</a>
                      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">View all X'ecutive Brands</a>
                    {% elsif label_key contains 'packed' %}
                      <a href="{{ routes.search_url }}?q=gift+set">All Gift Sets</a>
                      <a href="{{ routes.search_url }}?q=cooler+gift+set">Cooler Gift Sets</a>
                      <a href="{{ routes.search_url }}?q=drinkware+gift+set">Drinkware Gift Sets</a>
                    {% elsif label_key contains 'treme' %}
                      <a href="{{ routes.search_url }}?q=golf+bag">Golf Bags</a>
                      <a href="{{ routes.search_url }}?q=golf+towel">Golf Towels</a>
                      <a href="{{ routes.search_url }}?q=golf+accessories">Golf Accessories</a>
                      <a href="{{ routes.search_url }}?q=golf+apparel">Golf Apparel</a>
                      <a href="{{ routes.search_url }}?q=golf+drinkware">Golf Drinkware</a>
                      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">View all X'treme Golf</a>
                    {% else %}
                      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">Shop {{ block.settings.label }}</a>
                    {% endif %}
                  </div>

                  {% if navigation_style == 'mega' and block.settings.featured_image != blank %}
                    <a class="ii-brand-panel__feature" href="{{ block.settings.featured_link | default: block.settings.link }}">
                      {{ block.settings.featured_image | image_url: width: 560 | image_tag: widths: '280, 420, 560', loading: 'lazy', alt: block.settings.featured_label }}
                      {% if block.settings.featured_label != blank %}<span>{{ block.settings.featured_label }}</span>{% endif %}
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </nav>

      {% if settings.predictive_search_enabled %}
        <predictive-search class="ii-search" data-loading-text="{{ 'accessibility.loading' | t }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="ii-search__form">
            <label class="visually-hidden" for="ii-search-{{ section.id }}">Search products</label>
            <input
              id="ii-search-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder }}"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="type" value="product">
            <button class="ii-search__reset hidden" type="reset" aria-label="{{ 'general.search.reset' | t }}">
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="m4 4 10 10M14 4 4 14"/></svg>
            </button>
            <button class="ii-search__submit" type="submit" aria-label="{{ 'general.search.search' | t }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
            </button>
            <div class="ii-search__results predictive-search" tabindex="-1" data-predictive-search>
              <div class="predictive-search__loading-state" aria-hidden="true">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
              </div>
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          </form>
        </predictive-search>
      {% else %}
        <form class="ii-search ii-search__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="ii-search-{{ section.id }}">Search products</label>
          <input id="ii-search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}">
          <input type="hidden" name="type" value="product">
          <button class="ii-search__submit" type="submit" aria-label="{{ 'general.search.search' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
          </button>
        </form>
      {% endif %}

      <a class="ii-meeting" href="{{ meeting_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="14" height="14" rx="2"/><path d="m16 10 6-3v10l-6-3M6 9h5M6 13h3"/></svg>
        <span>{{ section.settings.meeting_label }}</span>
      </a>

      <div class="ii-mobile-actions">
        <a class="ii-mobile-icon" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0"/></svg>
        </a>
        <a class="ii-mobile-icon" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
          {% if cart == empty %}{% render 'icon-cart-empty' %}{% else %}{% render 'icon-cart' %}{% endif %}
          {% if cart != empty %}<span class="ii-mobile-cart-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif %}
        </a>
      </div>
    </div>

    <div class="ii-mobile-nav" id="ii-mobile-nav-{{ section.id }}" hidden data-ii-mobile-nav>
      <form class="ii-mobile-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="ii-mobile-search-{{ section.id }}">Search products</label>
        <input id="ii-mobile-search-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder }}">
        <input type="hidden" name="type" value="product">
        <button type="submit">{{ 'general.search.search' | t }}</button>
      </form>

      <details>
        <summary>{{ section.settings.categories_label }}</summary>
        <div class="ii-mobile-nav__group">
          {% for link in category_menu.links %}
            {% if link.links.size > 0 %}
              <details>
                <summary>{{ link.title }}</summary>
                <a class="ii-mobile-nav__view" href="{{ link.url }}">View all {{ link.title }}</a>
                {% for childlink in link.links %}<a href="{{ childlink.url }}">{{ childlink.title }}</a>{% endfor %}
              </details>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </details>

      {% for block in section.blocks %}
        {% if block.type == 'brand_link' %}
          {% if block.settings.menu.links.size > 0 %}
            <details>
              <summary>{{ block.settings.label }}</summary>
              <div class="ii-mobile-nav__group">
                <a class="ii-mobile-nav__view" href="{{ block.settings.link | default: routes.all_products_collection_url }}">View all {{ block.settings.label }}</a>
                {% for link in block.settings.menu.links %}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                  {% for childlink in link.links %}<a class="ii-mobile-nav__child" href="{{ childlink.url }}">{{ childlink.title }}</a>{% endfor %}
                {% endfor %}
              </div>
            </details>
          {% else %}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}

      <details>
        <summary>{{ section.settings.utility_label }}</summary>
        <div class="ii-mobile-nav__group">
          {% if utility_menu.links.size > 0 %}
            {% for link in utility_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
          {% else %}
            <a href="/pages/create-flyer">Create Flyer</a>
            <a href="/pages/sales-flyer">Sales Flyer</a>
            <a href="/pages/order-catalog">Order Catalog</a>
            <a href="/pages/submit-a-po">Submit a PO</a>
            <a href="/pages/view-catalog">View Catalog</a>
            <a href="/pages/stock-designs">Stock Designs</a>
          {% endif %}
        </div>
      </details>

      <a href="{{ meeting_url }}">{{ section.settings.meeting_label }}</a>
    </div>
  </div>
</header>

<style>
  /* Measured desktop header layout */
  @media screen and (min-width:1001px){
  .ii-header{width:100%;min-height:132px}
  .ii-header .ii-shell{width:min(100% - 60px,1499px);max-width:1499px;margin:0 auto}
  .ii-announcement{height:36px;min-height:36px}
  .ii-announcement__inner{height:36px;min-height:36px}
  .ii-mainbar{height:96px;min-height:96px}
  .ii-mainbar__inner{height:96px;min-height:96px;max-width:1499px}
  .ii-logo{width:230px;height:63px;display:flex;align-items:center;flex:0 0 230px}
  .ii-logo img{width:230px;height:45px;object-fit:contain}
  .ii-categories__trigger,.ii-brandnav__trigger,.ii-brandnav__link{height:95px}
  .ii-search{height:40px;min-height:40px}
  .ii-search__form{height:40px;min-height:40px}
  .ii-search input{height:40px;min-height:40px}
  .ii-meeting{width:86px;height:40px;min-height:40px;display:inline-flex;align-items:center;justify-content:center}
  .ii-meeting svg{width:18px;height:18px}
  }
  </style>
  {% schema %}
{
  "name": "ImprintID header",
  "tag": "section",
  "class": "section-header",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 140, "max": 280, "step": 10, "unit": "px", "label": "Logo width", "default": 190 },
    { "type": "text", "id": "announcement_text", "label": "Announcement", "default": "Worried about the tariff? No problem –" },
    { "type": "text", "id": "announcement_link_label", "label": "Announcement link label", "default": "Learn More" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "text", "id": "utility_label", "label": "Utility menu label", "default": "Distributor Tools" },
    { "type": "link_list", "id": "utility_menu", "label": "Distributor Tools menu" },
    { "type": "link_list", "id": "utility_catalog_menu", "label": "View Catalog submenu" },
    { "type": "text", "id": "categories_label", "label": "Categories label", "default": "CATEGORIES" },
    { "type": "link_list", "id": "category_menu", "label": "Category menu", "default": "main-menu" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search Products" },
    { "type": "text", "id": "meeting_label", "label": "Meeting button label", "default": "Book a Meeting" },
    { "type": "url", "id": "meeting_url", "label": "Meeting button link" },
    { "type": "image_picker", "id": "mega_promo_image", "label": "Categories promotion image" },
    { "type": "text", "id": "mega_promo_title", "label": "Categories promotion title", "default": "Explore Custom Promotional Products" },
    { "type": "url", "id": "mega_promo_link", "label": "Categories promotion link" }
  ],
  "blocks": [
    {
      "type": "brand_link",
      "name": "Brand navigation item",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Brand" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "url", "id": "link", "label": "Primary link" },
        {
          "type": "select",
          "id": "navigation_style",
          "label": "Navigation style",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "link", "label": "Direct link" },
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "mega", "label": "Mega menu" }
          ],
          "default": "auto"
        },
        { "type": "link_list", "id": "menu", "label": "Dropdown menu" },
        { "type": "image_picker", "id": "featured_image", "label": "Mega menu featured image" },
        { "type": "text", "id": "featured_label", "label": "Featured image label" },
        { "type": "url", "id": "featured_link", "label": "Featured image link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ImprintID header",
      "blocks": [
        { "type": "brand_link" },
        { "type": "brand_link" },
        { "type": "brand_link" },
        { "type": "brand_link" },
        { "type": "brand_link" }
      ]
    }
  ]
}
{% endschema %}


<style>
    html, body { overflow-x: clip; }
      .ii-header, .ii-header * { box-sizing: border-box; }
        .ii-header .ii-mainbar, .ii-header .ii-shell { width: 100%; max-width: 100%; min-width: 0; }
          .ii-header [class*="nav"], .ii-header [class*="search"], .ii-header [class*="bar"] { min-width: 0; max-width: 100%; }
            cart-drawer:not(.active):not([open]), cart-drawer[aria-hidden="true"] { position: fixed; inset: 0; visibility: hidden; pointer-events: none; z-index: -1; }
              .ii-product-rail { display: flex; gap: 16px; max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-bottom: 8px; }
                .ii-product-card { flex: 0 0 clamp(180px, 22vw, 230px); max-width: 230px; scroll-snap-align: start; }
                  .ii-product-rail-controls { display: flex; justify-content: flex-end; gap: 8px; margin: 0 0 12px; }
                    .ii-product-rail-controls button { appearance: none; border: 1px solid currentColor; background: transparent; color: inherit; min-width: 42px; min-height: 36px; padding: 6px 12px; cursor: pointer; }
                      .ii-product-rail-controls button:disabled { opacity: .4; cursor: not-allowed; }
                        @media (max-width: 1100px) {
                            .ii-header .ii-mainbar, .ii-header .ii-shell { padding-inline: clamp(12px, 2vw, 24px); }
                                .ii-header [class*="search"] { flex: 1 1 180px; }
                                  }
                                    @media (max-width: 749px) {
                                        .ii-header [class*="brand"] { display: none; }
                                            .ii-header [class*="search"] { order: 5; flex-basis: 100%; }
                                                .ii-product-card { flex-basis: min(72vw, 230px); }
                                                  }
                                                  </style>
                                                  <script>
                                                    (() => {
                                                        const initHomeFixes = () => {
                                                              const categoryButton = document.querySelector('button[id^="ii-categories-trigger"]');
                                                                    const categoryPanel = categoryButton && document.getElementById(categoryButton.getAttribute('aria-controls'));
                                                                          if (categoryButton && categoryPanel && !categoryButton.dataset.fixedInteraction) {
                                                                                  categoryButton.dataset.fixedInteraction = 'true';
                                                                                          const syncCategoryState = () => {
                                                                                                    const isOpen = !categoryPanel.hidden;
                                                                                                              categoryButton.setAttribute('aria-expanded', String(isOpen));
                                                                                                                        categoryButton.classList.toggle('is-open', isOpen);
                                                                                                                                };
                                                                                                                                        categoryButton.addEventListener('click', () => requestAnimationFrame(() => { categoryPanel.hidden = !categoryPanel.hidden; syncCategoryState(); }), true);
                                                                                                                                                syncCategoryState();
                                                                                                                                                      }
                                                                                                                                                            const rail = document.querySelector('.ii-product-rail');
                                                                                                                                                                  if (rail && !rail.dataset.controlsReady) {
                                                                                                                                                                          rail.dataset.controlsReady = 'true';
                                                                                                                                                                                  const controls = document.createElement('div');
                                                                                                                                                                                          controls.className = 'ii-product-rail-controls';
                                                                                                                                                                                                  const previous = document.createElement('button');
                                                                                                                                                                                                          const next = document.createElement('button');
                                                                                                                                                                                                                  previous.type = next.type = 'button'; previous.textContent = '‹'; next.textContent = '›';
                                                                                                                                                                                                                          previous.setAttribute('aria-label', 'Previous products'); next.setAttribute('aria-label', 'Next products');
                                                                                                                                                                                                                                  controls.append(previous, next); rail.parentElement.insertBefore(controls, rail);
                                                                                                                                                                                                                                          const updateControls = () => { previous.disabled = rail.scrollLeft <= 1; next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 1; };
                                                                                                                                                                                                                                                  previous.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth * .8, behavior: 'smooth' }));
                                                                                                                                                                                                                                                          next.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth * .8, behavior: 'smooth' }));
                                                                                                                                                                                                                                                                  rail.addEventListener('scroll', updateControls, { passive: true }); window.addEventListener('resize', updateControls); updateControls();
                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                              document.querySelectorAll('.ii-footer__socials').forEach((socials) => { if (!socials.children.length && !socials.textContent.trim()) { const heading = socials.previousElementSibling; if (heading && heading.classList.contains('ii-footer__subheading')) heading.remove(); socials.remove(); } });
                                                                                                                                                                                                                                                                                  };
                                                                                                                                                                                                                                                                                      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHomeFixes); else initHomeFixes();
                                                                                                                                                                                                                                                                                        })();
                                                                                                                                                                                                                                                                                        </script>

                                                                                                                                                                                                                                                                                        <style>
                                                                                                                                                                                                                                                                                        .ii-header .ii-mainbar, .ii-header .ii-shell { padding-inline: 16px; margin-inline: 0; width: 100%; max-width: 100%; }
                                                                                                                                                                                                                                                                                        .ii-header .ii-mainbar { gap: clamp(10px, 1.5vw, 20px); }
                                                                                                                                                                                                                                                                                        .ii-header img { max-width: 100%; height: auto; }
                                                                                                                                                                                                                                                                                        @media (max-width: 900px) { .ii-header .ii-mainbar { gap: 10px; } }
                                                                                                                                                                                                                                                                                        @media (max-width: 749px) { .ii-header .ii-mainbar { padding-inline: 12px; gap: 8px; } }
                                                                                                                                                                                                                                                                                        
@media screen and (min-width:1001px){
  .ii-header .ii-mainbar__inner{display:flex!important;align-items:center!important;gap:0!important;overflow:hidden!important;width:min(100% - 60px,1499px)!important;max-width:1499px!important}
  .ii-header .ii-logo{flex:0 0 230px!important;width:230px!important;margin-right:12px!important}
  .ii-header .ii-categories{flex:0 0 148px!important;width:148px!important;min-width:0!important}
  .ii-header .ii-brandnav{flex:1 1 auto!important;min-width:0!important;overflow:hidden!important;display:flex!important}
  .ii-header .ii-search{flex:0 0 213px!important;width:213px!important;min-width:213px!important;margin-left:12px!important}
  .ii-header .ii-meeting{flex:0 0 86px!important;width:86px!important;min-width:86px!important;margin-left:12px!important;white-space:nowrap!important;overflow:hidden!important}
  .ii-header .ii-meeting span{white-space:nowrap!important}
}
</style>
                                                                                                                                                                                                                                                                                        