{{ 'section-imprintid-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'imprintid-product-form-' | append: section.id
  assign product_code = product.metafields.custom.product_code.value | default: product.vendor | default: product.id
  assign color_option = blank
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour'
      assign color_option = option
    endif
  endfor
-%}
<div class="ii-product" id="Product-{{ section.id }}">
  <div class="ii-product__breadcrumbs page-width"><a href="{{ routes.root_url }}">Home</a><span>/</span>{% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}<span>{{ product.title }}</span></div>
  <div class="ii-product__main page-width">
    <div class="ii-product__gallery"><div class="ii-product__media-list">
      {% for media in product.media %}{% if media.media_type == 'image' %}<div class="ii-product__media{% unless forloop.first %} ii-product__media--secondary{% endunless %}">{{ media | image_url: width: 1100 | image_tag: widths: '480, 720, 900, 1100', sizes: '(min-width: 990px) 48vw, 100vw', loading: 'lazy', alt: media.alt | default: product.title }}</div>{% endif %}{% endfor %}
      {% if product.media.size == 0 %}{{ 'product-1' | placeholder_svg_tag: 'ii-product__placeholder' }}{% endif %}
    </div></div>
    <div class="ii-product__summary">
      <div class="ii-product__badges"><span class="ii-product__code">#{{ product_code }}</span>{% if product.compare_at_price > product.price %}<span class="ii-product__sale">BEST SELLER</span>{% endif %}<button class="ii-product__favorite" type="button" aria-label="Add {{ product.title | escape }} to wishlist">♡</button></div>
      <h1>{{ product.title }}</h1>
      {% if product.description != blank %}<div class="ii-product__short-description">{{ product.description | strip_html | truncatewords: 24 }}</div>{% endif %}
      {% form 'product', product, id: product_form_id, class: 'ii-product__form', novalidate: 'novalidate' %}
        <div class="ii-product__pricing"><div class="ii-product__pricing-title">{{ section.settings.pricing_heading }}</div><div class="ii-product__quantity-row"><span>Quantity</span>{% for quantity in section.settings.quantities | split: ',' %}<span>{{ quantity | strip }}</span>{% endfor %}</div><div class="ii-product__price-row"><span>{{ section.settings.price_label }}</span>{% for quantity in section.settings.quantities | split: ',' %}<strong>{{ current_variant.price | money }}</strong>{% endfor %}</div></div>
        {% unless product.has_only_default_variant %}<label class="ii-product__select-label" for="Variant-{{ section.id }}">Choose an option</label><select id="Variant-{{ section.id }}" name="id" class="ii-product__variant-select">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}
        <div class="ii-product__purchase"><label for="Quantity-{{ section.id }}">Qty</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button type="submit" class="ii-product__add"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.add_button_label }}{% else %}Sold out{% endif %}</button></div>
      {% endform %}
      <div class="ii-product__tools"><h2>Distributor Tools</h2><div class="ii-product__tools-grid">{% assign tool_labels = section.settings.tool_labels | split: '|' %}{% for label in tool_labels %}<a href="{{ section.settings.tool_link | default: routes.contact_url }}"><span aria-hidden="true">▣</span>{{ label | strip }}</a>{% endfor %}</div></div>
      {% if color_option != blank %}<div class="ii-product__colors"><h2>{{ color_option.name }}</h2><div class="ii-product__swatches">{% for value in color_option.values %}<span class="ii-product__swatch" title="{{ value }}" aria-label="{{ value }}">{{ value | slice: 0, 1 }}</span>{% endfor %}</div></div>{% endif %}
      {% if section.settings.features != blank %}<div class="ii-product__features"><h2>Features</h2>{{ section.settings.features }}</div>{% endif %}
    </div>
  </div>
  <div class="ii-product__detail-nav"><div class="page-width">{% for block in section.blocks %}<a href="#ii-detail-{{ block.id }}">{{ block.settings.heading }}</a>{% endfor %}</div></div>
  <div class="ii-product__details">{% for block in section.blocks %}<section class="ii-product__detail-band ii-product__detail-band--{{ block.settings.tone }}" id="ii-detail-{{ block.id }}" {{ block.shopify_attributes }}><div class="page-width"><h2>{{ block.settings.heading }}<span>−</span></h2>{% if block.settings.image != blank %}<div class="ii-product__detail-image">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.heading }}</div>{% endif %}<div class="ii-product__detail-content">{{ block.settings.content }}</div></div></section>{% endfor %}</div>
  {% if section.settings.related_collection != blank %}<section class="ii-product__related page-width"><h2>{{ section.settings.related_heading }}</h2><div class="ii-product__related-grid">{% for related in section.settings.related_collection.products limit: 4 %}{% unless related.id == product.id %}<a href="{{ related.url }}">{% if related.featured_image %}{{ related.featured_image | image_url: width: 460 | image_tag: loading: 'lazy', alt: related.title }}{% endif %}<strong>{{ related.title }}</strong><span>{{ related.price | money }}</span></a>{% endunless %}{% endfor %}</div></section>{% endif %}
</div>
<script>
  (() => { const select = document.querySelector('#Variant-{{ section.id }}'); if (!select) return; select.addEventListener('change', () => { const button = document.querySelector('#{{ product_form_id }} .ii-product__add'); const option = select.options[select.selectedIndex]; if (button) { button.disabled = option.disabled; button.textContent = option.disabled ? 'Sold out' : '{{ section.settings.add_button_label | escape }}'; } }); })();
</script>
{% schema %}
{"name":"ImprintID product","tag":"section","class":"section-imprintid-product","settings":[{"type":"text","id":"pricing_heading","label":"Pricing heading","default":"SCREEN PRINT"},{"type":"text","id":"quantities","label":"Quantity columns","default":"50, 100, 250, 500, 1000"},{"type":"text","id":"price_label","label":"Price label","default":"Screen Print - List Price"},{"type":"text","id":"add_button_label","label":"Add button label","default":"Add to cart"},{"type":"textarea","id":"tool_labels","label":"Distributor tool labels","default":"Check Inventory|Shipping Estimator|Request a Quote|Create a Virtual|Request A Virtual|Artwork Templates|High Res Images|Presentation Tool|Add To Compare"},{"type":"url","id":"tool_link","label":"Distributor tools link"},{"type":"richtext","id":"features","label":"Features","default":"<p>Durable promotional product<br>Easy to customize and decorate<br>High-quality materials</p>"},{"type":"text","id":"related_heading","label":"Related heading","default":"Related Items"},{"type":"collection","id":"related_collection","label":"Related collection"}],"blocks":[{"type":"details","name":"Product details","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product Details"},{"type":"richtext","id":"content","label":"Content","default":"<p><strong>Material</strong><br>Product specifications and imprint information.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"tone","label":"Tone","default":"light","options":[{"value":"light","label":"Light"},{"value":"blue","label":"Blue"}]}]},{"type":"decoration","name":"Decoration charges","settings":[{"type":"text","id":"heading","label":"Heading","default":"Decoration Charges"},{"type":"richtext","id":"content","label":"Content","default":"<p><strong>Screen Print</strong><br>Setup Charge<br>Additional color run charge</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"tone","label":"Tone","default":"blue","options":[{"value":"light","label":"Light"},{"value":"blue","label":"Blue"}]}]},{"type":"shipping","name":"Production and shipping","settings":[{"type":"text","id":"heading","label":"Heading","default":"Production and Shipping"},{"type":"richtext","id":"content","label":"Content","default":"<p><strong>Lead Time</strong><br>Production time 3-5 business days + applicable transit time.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"tone","label":"Tone","default":"light","options":[{"value":"light","label":"Light"},{"value":"blue","label":"Blue"}]}]},{"type":"packaging","name":"Packaging information","settings":[{"type":"text","id":"heading","label":"Heading","default":"Packaging Information"},{"type":"richtext","id":"content","label":"Content","default":"<p><strong>Units Per Carton</strong><br>100</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"tone","label":"Tone","default":"blue","options":[{"value":"light","label":"Light"},{"value":"blue","label":"Blue"}]}]},{"type":"disclaimer","name":"Disclaimer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Disclaimer"},{"type":"richtext","id":"content","label":"Content","default":"<p><strong>Printing Color</strong><br>Actual printing colors can slight differ in the final product.</p>"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"tone","label":"Tone","default":"light","options":[{"value":"light","label":"Light"},{"value":"blue","label":"Blue"}]}]}],"presets":[{"name":"ImprintID product","blocks":[{"type":"details"},{"type":"decoration"},{"type":"shipping"},{"type":"packaging"},{"type":"disclaimer"}]}]}
{% endschema %}
