{% doc %}
  @prompt
    enter using password, make this section hover on the bottom left over above the banner image, make the button more simple as the header enter using password, reduce section size..the enter using password section should be regular text not bold
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-password-entry-{{ ai_gen_id }} {
    display: block;
    position: absolute;
    z-index: 5;
    left: 20px;
    bottom: 20px;
    width: min({{ block.settings.desktop_width_percent }}%, 360px);
    max-width: calc(100% - 40px);
    margin: 0;
    padding: 16px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: left;
    box-sizing: border-box;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.16);
  }
  .ai-password-entry-{{ ai_gen_id }}__inner { width: 100%; margin: 0; }
  .ai-password-entry-{{ ai_gen_id }}__title { margin: 0 0 8px; color: inherit; font-size: 20px; font-weight: 400; line-height: 1.3; }
  .ai-password-entry-{{ ai_gen_id }}__message { margin: 0 0 14px; color: inherit; font-size: 14px; line-height: 1.4; }
  .ai-password-entry-{{ ai_gen_id }}__form { display: flex; flex-direction: column; gap: 9px; text-align: left; }
  .ai-password-entry-{{ ai_gen_id }}__label { color: inherit; font-size: 13px; font-weight: 400; }
  .ai-password-entry-{{ ai_gen_id }}__input { width: 100%; min-height: 40px; padding: 9px 11px; border: 1px solid {{ block.settings.text_color }}; border-radius: 2px; background: {{ block.settings.input_background }}; color: {{ block.settings.text_color }}; font: inherit; box-sizing: border-box; }
  .ai-password-entry-{{ ai_gen_id }}__input:focus-visible,
  .ai-password-entry-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-password-entry-{{ ai_gen_id }}__button { align-self: flex-start; padding: 0; border: 0; border-bottom: 1px solid currentColor; background: transparent; color: {{ block.settings.text_color }}; font: inherit; font-size: 16px; font-weight: 400; line-height: 1.4; cursor: pointer; }
  .ai-password-entry-{{ ai_gen_id }}__button:hover { opacity: 0.75; }
  .ai-password-entry-{{ ai_gen_id }}__error { margin: 0; color: {{ block.settings.error_color }}; font-size: 13px; }
  @media screen and (max-width: 749px) {
    .ai-password-entry-{{ ai_gen_id }} { left: 10px; bottom: 10px; width: calc(100% - 20px); max-width: 360px; padding: 14px; }
    .ai-password-entry-{{ ai_gen_id }}__title { font-size: 18px; }
  }
{% endstyle %}

<div class="ai-password-entry-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-password-entry-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h1 class="ai-password-entry-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h1>{% endif %}
    {% if block.settings.message != blank %}<p class="ai-password-entry-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>{% endif %}
    {% form 'storefront_password' %}
      <div class="ai-password-entry-{{ ai_gen_id }}__form">
        <label class="ai-password-entry-{{ ai_gen_id }}__label" for="Password-{{ ai_gen_id }}">{{ block.settings.password_label | escape }}</label>
        <input class="ai-password-entry-{{ ai_gen_id }}__input" type="password" name="password" id="Password-{{ ai_gen_id }}" autocomplete="current-password" required {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError-{{ ai_gen_id }}"{% endif %}>
        <button class="ai-password-entry-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
        {% if form.errors %}<p class="ai-password-entry-{{ ai_gen_id }}__error" id="PasswordError-{{ ai_gen_id }}" role="alert">{{ block.settings.error_message | escape }}</p>{% endif %}
      </div>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password entry",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enter using password" },
    { "type": "text", "id": "message", "label": "Message", "default": "Enter the store password to continue." },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Store password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "The password you entered is incorrect. Please try again." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAFAF9" },
    { "type": "color", "id": "input_background", "label": "Input background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#121212" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "error_color", "label": "Error text", "default": "#B42318" }
  ],
  "presets": [{ "name": "Password entry" }],
  "tag": null,
  "class": "password-entry-block"
}
{% endschema %}